{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "TCR Local Web Server",
            "type": "shell",
            "command": "python3",
            "args": [
                "-m",
                "http.server",
                "5500"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen"
            },
            "problemMatcher": []
        }
    ]
}